{
  "name": "kobin-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:e2e": "NEXT_DIST_DIR=.next-e2e next build",
    "start": "next start",
    "start:e2e": "NEXT_DIST_DIR=.next-e2e next start -p 3100",
    "lint": "eslint",
    "test:dod": "tsx --test src/lib/dod-gate.test.ts",
    "test": "npm run test:dod && npm run test:materials && npm run test:turntable && npm run test:robot && npm run test:three",
    "test:e2e:dod": "playwright test e2e/dod-gate.spec.ts",
    "test:e2e": "npm run test:e2e:dod && npm run test:e2e:materials && npm run test:e2e:turntable && npm run test:e2e:robot && npm run test:e2e:home",
    "test:materials": "tsx --test src/lib/material-spheres.test.ts",
    "test:e2e:materials": "playwright test e2e/material-spheres.spec.ts",
    "test:turntable": "tsx --test src/lib/product-turntable.test.ts",
    "test:e2e:turntable": "playwright test e2e/product-turntable.spec.ts",
    "test:robot": "tsx --test src/lib/robot-arm.test.ts",
    "test:e2e:robot": "playwright test e2e/robot-arm.spec.ts",
    "test:three": "tsx --test src/lib/three/quality.test.ts src/lib/three/timeline.test.ts src/lib/three/assets.test.ts src/lib/hero-timeline.test.ts src/lib/experience-flow.test.ts",
    "test:e2e:home": "playwright test e2e/home-hero.spec.ts"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@react-three/postprocessing": "^3.1.1",
    "framer-motion": "^13.2.0",
    "next": "^15.5.25",
    "postprocessing": "^6.39.5",
    "react": "~19.2.8",
    "react-dom": "~19.2.8",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.4",
    "eslint": "^9",
    "eslint-config-next": "^15.5.25",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
